# Get a free token at https://huggingface.co/settings/tokens (Read access is enough)
HUGGINGFACE_API_KEY=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

# Comma separated list of origins allowed to call this API.
# For local dev the Vite defaults are already included in config.py.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# SQLite by default -> file lives at backend/mysky.db
# For a hosted Postgres (Render/Railway/Supabase) swap in that URL instead.
DATABASE_URL=sqlite:///./mysky.db
